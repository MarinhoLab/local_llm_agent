context/
.env

# Weight/compile caches created inside a DGX stack folder (see each compose.yml)
dgx_spark_host/*/*cache/
dgx_spark_host/*/.triton/


# opencode_native runtime data: generated config, sessions (opencode.db),
# XDG-isolated data/cache, notifier state (kept on the host, never committed)
opencode_native/opencode-state/

# ntfy server config & data (per-PC push server, see ntfy/)
ntfy/.env

# Python (ntfy_notifier.py runs with the interpreter pinned in run.sh)
__pycache__/

# Long-task logs and transient artifacts
artifacts/logs/
