# .env
# Edit values below as needed. Copy to .env (git-ignored).

# Ingress port on the host. 8010 avoids 8000 (vLLM tunnel) used by the
# other stack in this repo.
AGENT_CANVAS_PORT=8010

# Image tag. Keep `latest` for auto-updates (`docker compose pull` first);
# pin a specific tag before a release for reproducibility.
AGENT_CANVAS_TAG=latest

# Host directory for settings, LLM profile, API key, and conversation data.
# Mounted at /home/openhands/.openhands inside the container.
AGENT_CANVAS_STATE=./openhands-state

# Host directory mounted at /projects — the project files agents may work in.
PROJECTS_DIR=./projects

# Host path of the Docker daemon socket, bind-mounted into the container at
# /var/run/docker.sock so the agent talks to the HOST daemon directly (no
# nested dockerd, no docker-in-docker). The default works on Linux and on
# Docker Desktop (macOS/Windows). Change it only if your socket lives
# elsewhere (e.g. //./pipe/dockerDesktopLinuxContainers on Windows).
# Remove the corresponding line from compose.yml to run with no host socket
# at all (the agent then has no Docker unless it runs its own nested daemon).
AGENT_CANVAS_DOCKER_SOCKET=/var/run/docker.sock

# Off by default: with the host socket shared above, the agent drives the host
# daemon and needs no CAP_SYS_ADMIN, so the stricter "the container is the
# sandbox boundary" posture holds. Set to true only if the agent must run its
# OWN nested `dockerd` (host has no daemon, or you want the agent's containers
# isolated from the host daemon) — that needs CAP_SYS_ADMIN and weakens the
# sandbox boundary (an escaping agent reaches the host).
AGENT_CANVAS_PRIVILEGED=false

# --- optional ---

# API key for the agent-server API. Optional for local use: Agent Canvas
# auto-generates and persists one in the state mount. Required in --public mode.
# LOCAL_BACKEND_API_KEY=

# Secret used to protect stored settings and secrets.
# OH_SECRET_KEY=

# Pin a specific agent-server version, e.g. 0.1.0.
# OH_AGENT_SERVER_VERSION=
