# agent_canvas_native/.env — configuration for the *native* Agent Canvas stack.
#
# Copied to .env by install.sh (and .env is git-ignored). run.sh sources this
# file. Leave a value empty to use the default shown.
#
# The Agent Canvas launcher reads the ingress port from --port (run.sh passes
# AGENT_CANVAS_PORT) and the state dir from OH_CANVAS_SAFE_STATE_DIR (run.sh
# sets it from AGENT_CANVAS_STATE). AGENT_CANVAS_PORT / AGENT_CANVAS_STATE are
# OUR knobs in this folder; the OH_CANVAS_SAFE_* vars are the launcher's.

# Ingress (the UI + proxied API) port.
#   8000 = vLLM tunnel · 8010 = the Docker Agent Canvas stack · 8020 = this one.
AGENT_CANVAS_PORT=8020

# Where the stack keeps per-conversation runtime state: conversations,
# workspaces, terminal history, blob storage and logs (git-ignored).
# Default: ./openhands-state, resolved to <this folder>/openhands-state no
# matter where you run from. (The API key, encryption key and your LLM profile
# always live in ~/.openhands — see README "State & where things live".)
AGENT_CANVAS_STATE=./openhands-state

# vLLM endpoint used by run.sh for its preflight warning, and the value you
# enter on the Settings > LLM page. Matches the repo's other vLLM clients.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=local-dgx-key

# --- Advanced (uncomment to override) ---------------------------------------
# Internal service ports. On a normal Mac these are free (18000/18001); the
# launcher reserves them alongside the ingress port. Override only if they
# collide with something else on your machine (e.g. a *second* Canvas stack,
# or this sandbox's own Agent Canvas, which already occupies 18000/18001).
#OH_CANVAS_SAFE_BACKEND_PORT=18000
#OH_CANVAS_SAFE_AUTOMATION_PORT=18001

# Pin the auto-generated session API key instead of letting the launcher mint
# and persist one at ~/.openhands/agent-canvas/api-key.txt.
#LOCAL_BACKEND_API_KEY=change-me

# Pin the underlying stack versions (the npm package pins these by default):
#OH_AGENT_SERVER_VERSION=
#OH_AUTOMATION_VERSION=
