# agent_canvas_native/.env — configuration for the *native* Agent Canvas stack.
#
# Copied to .env by install.sh (and .env is git-ignored). run.sh sources this
# file. Leave a value empty to use the default shown.
#
# The Agent Canvas launcher reads the ingress port from --port (run.sh passes
# AGENT_CANVAS_PORT) and the state dir from OH_CANVAS_SAFE_STATE_DIR (run.sh
# sets it from AGENT_CANVAS_STATE). AGENT_CANVAS_PORT / AGENT_CANVAS_STATE are
# OUR knobs in this folder; the OH_CANVAS_SAFE_* vars are the launcher's.

# Ingress (the UI + proxied API) port.
#   8000 = vLLM tunnel · 8020 = this one.
AGENT_CANVAS_PORT=8020

# Where the stack keeps per-conversation runtime state: conversations,
# workspaces, terminal history, blob storage and logs (git-ignored).
# Default: ./openhands-state, resolved to <this folder>/openhands-state no
# matter where you run from. (The API key, encryption key and your LLM profile
# always live in ~/.openhands — see README "State & where things live".)
AGENT_CANVAS_STATE=./openhands-state

# vLLM endpoint used by run.sh for its preflight warning, and the value you
# enter on the Settings > LLM page. Matches the repo's other vLLM clients.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=local-dgx-key

# --- Advanced (uncomment to override) ---------------------------------------
# Internal service ports. On a normal Mac these are free (18000/18001); the
# launcher reserves them alongside the ingress port. Override only if they
# collide with something else on your machine (e.g. a *second* Canvas stack,
# or this sandbox's own Agent Canvas, which already occupies 18000/18001).
#OH_CANVAS_SAFE_BACKEND_PORT=18000
#OH_CANVAS_SAFE_AUTOMATION_PORT=18001

# Pin the auto-generated session API key instead of letting the launcher mint
# and persist one at ~/.openhands/agent-canvas/api-key.txt.
#LOCAL_BACKEND_API_KEY=change-me

# --- ntfy notifications -----------------------------------------------------
# When NTFY_ENABLED=true, run.sh starts the notifier daemon
# (agent_canvas_native/ntfy_notifier.py) alongside the stack. It watches
# conversation status and pushes ntfy notifications when your agent finishes,
# needs input, or hits an error. See "Notifications" in README.md and the
# per-PC ntfy server in ../ntfy/.
#
# The notifier reads the session API key itself (from LOCAL_BACKEND_API_KEY or
# ~/.openhands/agent-canvas/api-key.txt) — it is never written to ntfy.
#
NTFY_ENABLED=false

# Where the notifier publishes. Default points at this PC's local ntfy server
# (ntfy/compose.yml, NTFY_PORT=2020). For the public service instead, use
# https://ntfy.sh and leave NTFY_AUTH_TOKEN empty.
NTFY_SERVER=http://127.0.0.1:2020

# Topic to publish to — effectively a password, so make it unguessable
# (e.g. agent-canvas-<8 random hex>). Same topic on every PC is fine: the
# machine label below keeps them apart.
NTFY_TOPIC=agent-canvas

# Access token of the ntfy server (ntfy/README.md shows how to create one).
# Empty for ntfy.sh or an unauthenticated local server.
NTFY_AUTH_TOKEN=

# shared      = one topic for all PCs; title is prefixed with NTFY_HOSTNAME
# one-per-PC  = same topic on every PC (the notifier only ever talks to its
#               own local server, so titles carry the hostname instead)
# one-per-conv= a sub-topic per conversation (great for per-conversation
#               phone filters/automation)
NTFY_TOPIC_MODE=shared

# Machine label used in notification titles. Default: the OS hostname.
# On Tailscale, set this to your tailnet name (e.g. mac / laptop).
NTFY_HOSTNAME=

# Base URL for tap-to-open deep links. Use this PC's Tailscale URL so the
# link works from your phone anywhere:  http://<pc>.tail:8020/conversations/
NTFY_DEEP_LINK_PREFIX=http://localhost:8020/conversations/

# Poll interval (s) and per-conversation cooldown between repeat notifications.
NTFY_POLL_SECONDS=5
NTFY_COOLDOWN_SECONDS=120

# Which statuses trigger a notification. Default:
#   idle,finished,error,stuck,waiting_for_confirmation
# (idle = the agent finished a turn and is waiting for your input.)
#NTFY_EVENTS=idle,finished,error,stuck,waiting_for_confirmation

# Include a short snippet of the agent's latest message in the notification.
NTFY_INCLUDE_MESSAGE=true

# Pin the underlying stack versions (the npm package pins these by default):
#OH_AGENT_SERVER_VERSION=
#OH_AUTOMATION_VERSION=
