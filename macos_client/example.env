# .env
# Edit values below as needed. All keys are required by compose.yml.

OPENHANDS_TAG=1.8
OPENHANDS_PORT=3000
AGENT_SERVER_IMAGE_REPOSITORY=ghcr.io/openhands/agent-server
# Keep in sync with the agent-server bundled in the OpenHands image (1.8 ships 1.42.1).
AGENT_SERVER_IMAGE_TAG=1.42.1-python
LOG_ALL_EVENTS=true
LLM_MODEL=openai/qwen-local
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_API_KEY=local-dgx-key
WORKSPACE_DIR=./workspace
OPENHANDS_STATE=./openhands-state

