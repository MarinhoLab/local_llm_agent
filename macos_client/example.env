# .env
# Edit values below as needed.

OPENHANDS_TAG=latest
OPENHANDS_PORT=3000
LOG_ALL_EVENTS=false
LOG_LEVEL=INFO
WORKSPACE_DIR=./workspace
OPENHANDS_STATE=./openhands-state

# NOTE: the LLM is NOT configured in this file. The V1 web app reads it from
# its own profile store (GUI: Settings -> LLM), persisted in OPENHANDS_STATE.
# Set it once in the UI after `docker compose up`:
#   Custom model: openai/qwen-local
#   Base URL:     http://host.docker.internal:8000/v1
#   API key:      local-dgx-key
# (The old LLM_MODEL / LLM_BASE_URL / LLM_API_KEY env vars are ignored by the
#  web app — see the note in compose.yml.)

# Tavily MCP (remote) API key. Leave blank in this template; fill in your real
# key in a local, git-ignored .env. See .agents/skills/mcp-search-servers/SKILL.md.
TAVILY_API_KEY=

