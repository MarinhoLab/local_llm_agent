# .env
# Edit values below as needed.

OPENHANDS_TAG=latest
OPENHANDS_PORT=3000
LOG_ALL_EVENTS=false
LOG_LEVEL=INFO
WORKSPACE_DIR=./workspace
OPENHANDS_STATE=./openhands-state

# LLM + MCP bootstrap (see MEMORIES.md). The V1 web app does NOT read these
# from the environment — on each start the `oh-bootstrap` sidecar copies them
# into the OpenHands settings store (the same store the GUI writes to). The
# file is the source of truth for model/base URL; a hand-set API key is
# preserved. Idempotent: a no-op once everything matches. Leave the LLM vars
# blank to skip LLM bootstrapping.
# LLM_PROFILE_NAME: the GUI auto-names a profile "openai/<model>", so match that
# to avoid ending up with two profiles for the same model.
LLM_MODEL=openai/qwen-local
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_API_KEY=local-dgx-key
LLM_PROFILE_NAME=openai_qwen-local

# MCP servers, same mechanism.
# DuckDuckGo (local SSE, keyless) — host-published port of the duckduckgo-mcp
# service. The URL must be one the OpenHands containers can reach.
DUCKDUCKGO_MCP_URL=http://host.docker.internal:8001/sse
# Tavily (remote). Leave TAVILY_API_KEY blank to skip registering Tavily.
# Put the real key in a local, git-ignored .env only — never commit it.
TAVILY_URL=https://mcp.tavily.com/mcp
TAVILY_API_KEY=

