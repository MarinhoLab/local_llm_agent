# .env
# Edit values below as needed. All keys are required by compose.yml.

OPENHANDS_TAG=latest
OPENHANDS_PORT=3000
LOG_ALL_EVENTS=false
LLM_MODEL=openai/qwen-local
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_API_KEY=local-dgx-key
WORKSPACE_DIR=./workspace
OPENHANDS_STATE=./openhands-state

# Tavily MCP (remote) API key. Leave blank in this template; fill in your real
# key in a local, git-ignored .env. See .agents/skills/mcp-search-servers/SKILL.md.
TAVILY_API_KEY=

