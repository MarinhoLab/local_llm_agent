# ntfy/.env — configuration for the local ntfy push server (ntfy/compose.yml).
#
# Copied to .env by the setup steps in ntfy/README.md. .env is git-ignored;
# only this example.env is tracked. NTFY_PORT / NTFY_BASE_URL must match what
# the notifier and the phone use. Leave a value empty to use the default.

# Host port the ntfy container is exposed on.
#   8000 = vLLM tunnel · 8020 = Agent Canvas ingress · 18000/18001 = internal.
#   2020 = ntfy (this stack).
NTFY_PORT=2020

# Public base URL for this ntfy server, as your phone will reach it over
# Tailscale. <hostname> is THIS PC's stable Tailscale name (tailscale ip -n).
# Example: http://mac.tail:2020
NTFY_BASE_URL=

# JWT signing secret; gates the admin UI and access-token endpoints.
# Generate with:  openssl rand -hex 32
# Leave empty only for a throwaway local test (not recommended).
NTFY_JWT_SECRET=

# Upstream that relays iOS "poll requests" via APNs. ntfy.sh is fine for a
# few PCs; see ntfy/README.md for the rate-limit caveat.
NTFY_UPSTREAM_BASE_URL=https://ntfy.sh

# Optional: persist server logs into the data volume.
#NTFY_LOG_FILE=/var/cache/ntfy/ntfy.log
