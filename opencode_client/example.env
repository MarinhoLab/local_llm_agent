# OpenCode client configuration for the DGX Spark vLLM model.
#
# Copy to .env (git-ignored) and edit as needed:
#   cp opencode_client/example.env opencode_client/.env
#
# The install/launch scripts read these values and generate the OpenCode
# provider config (opencode.json) and auth file (auth.json) from them.
# Keep the real .env out of Git — only this example is committed.
#
# NOTE: the scripts `source` this file with bash, so quote any value that
# contains spaces (e.g. the provider name below). Unquoted spaces break the
# line when sourced.

# Provider ID. This is the key under "provider" in opencode.json AND the top-level
# key in auth.json — all three must match exactly or OpenCode will not load the
# model.
OPENCODE_PROVIDER_ID=dgx-vllm

# Provider display name, shown in the OpenCode TUI (/models, model picker).
# Quoted because it contains spaces (the file is sourced, not parsed).
OPENCODE_PROVIDER_NAME="DGX Spark vLLM"

# Model ID, exactly as vLLM serves it. Must match an entry from GET /v1/models.
OPENCODE_MODEL_ID=qwen-local

# Model display name.
OPENCODE_MODEL_NAME=Qwen3.8-27B-FP8

# Base URL of the vLLM OpenAI-compatible API, as reachable from THIS machine.
# With the SSH tunnel (ssh -N -L 8000:127.0.0.1:8000 ...), this is 127.0.0.1:8000.
OPENCODE_BASE_URL=http://127.0.0.1:8000/v1

# API key. Must match the vLLM server's API_KEY (see dgx_spark_host/). The DGX
# stack's default is `local-dgx-key` — a non-production local placeholder that is
# already documented across this repo, not a real credential. If you rotate the
# vLLM key, update it here too. The key is written to the git-ignored auth.json,
# never to the committed config.
OPENCODE_API_KEY=local-dgx-key

# Model context window and max output tokens.
OPENCODE_CONTEXT_LENGTH=262144
OPENCODE_OUTPUT_LENGTH=16384

# Optional: pin the OpenCode version the installer should target.
# Unset = install the latest release. After validating a version, record it here.
# OPENCODE_VERSION=1.18.30
