# opencode_native/.env — configuration for the *native* OpenCode stack.
#
# Copied to .env by install.sh (and .env is git-ignored). run.sh sources this
# file. Leave a value empty to use the default shown.
#
# run.sh is the only thing that consumes these: it exports the OpenCode_*
# variables, points OPENCODE_CONFIG at the generated config, and execs either
# the TUI or `opencode serve`. Calling `opencode` directly skips all of that
# (no profile, no XDG isolation, no server password).

# vLLM endpoint from the SSH tunnel, and the key the DGX stacks expect.
# Same two knobs agent_canvas_native uses, so both clients share one config.
#   8000 = vLLM tunnel. Tunnel: ssh -N -L 8000:127.0.0.1:8000 USER@DGX_SPARK_IP
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=local-dgx-key

# Model ID vLLM serves. All three dgx_spark_host/ stacks alias it to
# `qwen-local`, so this never changes when you switch stacks.
VLLM_MODEL_ID=qwen-local

# --- Server mode (`./run.sh server`) ----------------------------------------
# `opencode serve` exposes the HTTP API (and the bundled web UI at /) that
# `opencode attach`, `opencode run --attach` and the ntfy notifier use.
# 4096 = opencode's own default; 8000/8020/18000/18001/2020 are taken by other
# stacks in this repo, so the defaults stay clear of them.
OPENCODE_SERVER_PORT=4096
# 127.0.0.1 = loopback only. Reach it from another machine the same way as the
# Canvas: an SSH tunnel (`ssh -L 4096:localhost:4096 host`) rather than a
# wider bind — with OPENCODE_AUTO=yes the server runs shell as you, so treat
# this as a shell credential.
OPENCODE_BIND_HOST=127.0.0.1
# HTTP basic auth for serve/attach (username defaults to `opencode`; override
# with OPENCODE_SERVER_USERNAME). install.sh generates a random one; run.sh
# refuses server mode while this is empty or REPLACE_ME. Rotate by replacing
# the value and restarting.
OPENCODE_SERVER_PASSWORD=REPLACE_ME

# --- Behaviour ---------------------------------------------------------------
# yes = pass --auto: auto-approve permissions not explicitly denied (edit and
# shell run without asking). Off by default: the agent edits files in place as
# your user, so the prompt is the safety net.
OPENCODE_AUTO=no

# --- Advanced (uncomment to override) ---------------------------------------
# Where the stack keeps its config and per-user state (sessions, snapshots,
# SQLite DB, logs). State is XDG-isolated here instead of ~/.local/share so
# this stack, its notifier, and your personal OpenCode stay separate.
#OPENCODE_STATE_DIR=./opencode-state
# Config file handed to opencode via OPENCODE_CONFIG. install.sh generates
# config/opencode.json from opencode.example.jsonc; point this at your own
# file to take over completely.
#OPENCODE_CONFIG=./config/opencode.json
# Directory for agents/commands/plugins/skills, via OPENCODE_CONFIG_DIR.
#OPENCODE_CONFIG_DIR=./config/opencode-dir

# Install-time knobs read by install.sh (also honoured by `run.sh upgrade`).
# Pin a validated release instead of tracking latest — opencode auto-updates
# itself otherwise, which run.sh disables. Strip a leading `v`.
#OPENCODE_VERSION=1.18.30
# Force an install method: curl (official installer, ~/.opencode/bin) or npm
# (opencode-ai into your npm prefix). Unset = reuse whatever is installed,
# else curl with an npm fallback.
#OPENCODE_INSTALL_METHOD=curl

# --- ntfy notifications -----------------------------------------------------
# With NTFY_ENABLED=true, run.sh starts ntfy_notifier.py alongside the stack.
# It watches sessions on the server and pushes an ntfy notification when an
# agent finishes a turn, is waiting on a permission prompt, or hits an error.
# See README → *Notifications (ntfy)* and the per-PC server in ../ntfy/.
NTFY_ENABLED=false

# Where the notifier publishes. Default = this PC's local ntfy server
# (ntfy/compose.yml, NTFY_PORT=2020). For the public service use
# https://ntfy.sh and leave NTFY_AUTH_TOKEN empty.
NTFY_SERVER=http://127.0.0.1:2020

# Topic to publish to — effectively a password, so make it unguessable
# (e.g. opencode-<16 random hex>). Same topic on every PC is fine: the machine
# label below keeps them apart.
NTFY_TOPIC=opencode

# Access token of the ntfy server (ntfy/README.md shows how to create one).
# Empty for ntfy.sh or an unauthenticated local server.
NTFY_AUTH_TOKEN=

# shared       = one topic for all PCs; the title carries NTFY_HOSTNAME
# one-per-PC   = same topic per PC (the notifier only talks to its own server)
# one-per-conv = a sub-topic per session (per-session phone filters)
NTFY_TOPIC_MODE=shared

# Machine label used in notification titles. Default: the OS hostname.
# On Tailscale, set this to your tailnet name (e.g. mac / laptop).
NTFY_HOSTNAME=

# Base URL of the web UI for tap-to-open deep links: taps open
# <base>/server/<key>/session/<id>, where <key> is derived from <base> exactly
# as the UI itself does, so the link lands on the server entry the browser
# saved. Default = NTFY_BASE_URL (i.e. http://localhost:4096 — fine on this
# PC). For a phone, use this PC's Tailscale URL, and open the web UI through
# that same URL once so the browser knows the server:
#   NTFY_DEEP_LINK_BASE=http://<pc>.tail:4096
# NTFY_DEEP_LINK_PREFIX is the escape hatch: a literal prefix with the session
# id appended, used instead of BASE when set (for non-default UI routings).
NTFY_DEEP_LINK_BASE=http://localhost:4096
# NTFY_DEEP_LINK_PREFIX=

# Poll interval (s) and per-session cooldown between repeat notifications.
NTFY_POLL_SECONDS=5
NTFY_COOLDOWN_SECONDS=120

# Which statuses trigger a notification. Default:
#   finished,error,waiting_for_input
# (finished = the turn ended and the session waits for you; waiting_for_input =
# a permission or question prompt is pending; retrying = the model endpoint is
# failing and opencode is backing off. 'running'/'idle' are also valid.)
#NTFY_EVENTS=finished,error,waiting_for_input

# Per-status ntfy priority (1=min … 5=max) overrides. Empty = the built-in
# defaults (finished=3, error=5, waiting_for_input=4, retrying=2, running=2).
#NTFY_PRIORITIES=finished=3,error=5,waiting_for_input=4,retrying=2

# Include a snippet of the agent's last message in the notification body.
NTFY_INCLUDE_MESSAGE=true
